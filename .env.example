# Optional server-side model connection. Never place secrets in app.js or data.js.
MODEL_ENDPOINT=
MODEL_API_KEY=
MODEL_NAME=
PORT=8765
HOST=127.0.0.1

# Optional EdgeOne model gateway, after account authorization:
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=
# AI_GATEWAY_MODEL=@makers/deepseek-v4-flash

# iFinD HTTP data service: official account permissions required.
# Blank means not connected. Never fill these in a committed file.
IFIND_REFRESH_TOKEN=
IFIND_ACCESS_TOKEN=
# Set true only after confirming the account permits this Web display.
IFIND_DISPLAY_AUTHORIZED=false
